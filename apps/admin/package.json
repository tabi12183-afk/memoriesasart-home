		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@mdxeditor/editor": "^3.14.0",
		"@tailwindcss/postcss": "^4.2.2",
		"autoprefixer": "^10.4.27",
		"bson": "^7.2.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"components": "workspace:*",
		"lucide-react": "^0.577.0",
		"next": "16.2.1",
		"next-themes": "^0.4.6",
		"postcss": "^8.5.8",
