{
	"name": "memories-as-art",
	"private": true,
	"version": "1.0.0",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"engines": {
		"node": ">=20.9.0"
	},
	"packageManager": "pnpm@10.33.0",
	"scripts": {
		"postinstall": "playwright install",
		"clean": "find . \\( -name 'node_modules' -o -name 'dist' -o -name '.next' -o -name '.turbo' \\) -type d -prune -exec rm -rf '{}' +",
		"clean:install": "rm -f pnpm-lock.yaml && pnpm clean && pnpm install",
		"upgrade:stormy": "pnpm -w add @stormycms/core@latest @stormycms/next@latest @stormycms/react@latest @stormycms/cli@latest @stormycms/theme@latest",
		"quality": "pnpm clean:install && pnpm quality:light && pnpm quality:heavy",
		"quality:light": "turbo lint format typecheck",
		"quality:heavy": "turbo build test test:e2e",
		"build": "turbo build",
		"dev": "turbo dev",
		"lint": "turbo lint",
		"lint:fix": "turbo lint:fix --affected",
		"format": "turbo format",
		"format:fix": "turbo format:fix --affected",
		"typecheck": "turbo typecheck",
		"test": "turbo test",
		"test:e2e": "turbo test:e2e",
		"init:env": "pnpm -r init:env"
	},
	"dependencies": {
		"@stormycms/cli": "^0.0.22",
		"@stormycms/core": "^0.0.25",
		"@stormycms/next": "^0.0.25",
		"@stormycms/react": "^0.0.17",
		"@stormycms/theme": "^0.0.6"
	},
	"devDependencies": {
		"@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
		"@eslint/js": "^9.39.4",
		"@playwright/test": "^1.52.0",
		"@types/node": "24",
		"@vitest/browser-playwright": "^4.1.10",
		"@vitest/coverage-v8": "^4.1.10",
		"eslint": "^9.39.4",
		"eslint-config-next": "^16.2.6",
		"globals": "^16.5.0",
		"playwright": "^1.52.0",
		"prettier": "^3.7.3",
		"turbo": "^2.5.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.48.0",
		"vitest": "^4.1.10"
	}
}
