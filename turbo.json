{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"globalEnv": [
		"STORMY_CMS_CLIENT_ID",
		"STORMY_CMS_CLIENT_SECRET",
		"STORMY_CMS_REDIRECT_URL",
		"NEXT_PUBLIC_SITE_URL",
		"NEXT_PUBLIC_PREVIEW_SITE_URL",
		"S3_ENDPOINT",
		"S3_BUCKET",
		"S3_ACCESS_KEY_ID",
		"S3_SECRET_ACCESS_KEY",
		"S3_REGION",
		"NEXT_DIST_DIR",
		"E2E_BYPASS_AUTH"
	],
	"globalPassThroughEnv": [
		"E2E_ALLOW_COOKIE_BYPASS",
		"E2E_BASE_URL",
		"E2E_TEST_DIR",
		"PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH",
		"PLAYWRIGHT_WORKERS"
	],
	"tasks": {
		"components#build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$"],
			"outputs": ["dist/**"]
		},
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": [".next/**", "!.next/cache/**"]
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"lint:fix": {
			"dependsOn": ["^lint:fix"]
		},
		"format": {
			"dependsOn": ["^format"]
		},
		"format:fix": {
			"dependsOn": ["^format:fix"]
		},
		"typecheck": {
			"dependsOn": ["^typecheck"]
		},
		"test": {
			"dependsOn": ["^test"]
		},
		"test:e2e": {
			"dependsOn": ["^build"],
			"cache": false
		},
		"dev": {
			"dependsOn": ["^build", "components#build"],
			"cache": false,
			"persistent": true
		}
	}
}
