{
	"name": "components",
	"version": "1.0.0",
	"description": "CMS components for the public site, also used by the page builder",
	"license": "ISC",
	"author": "",
	"type": "module",
	"main": "index.ts",
	"exports": {
		".": "./src/index.ts",
		"./styles.css": "./dist/styles.css",
		"./tailwind.css": "./src/tailwind.css"
	},
	"scripts": {
		"build": "postcss src/styles.css -o dist/styles.css",
		"lint": "eslint . --cache --cache-location=node_modules/.cache/eslint/.eslint-cache",
		"lint:fix": "pnpm lint -- --fix",
		"format": "prettier . --check --cache --cache-location=node_modules/.cache/prettier/.prettier-cache --ignore-path=../../.gitignore",
		"format:fix": "prettier . --write --ignore-path=../../.gitignore",
		"test": "vitest run --coverage",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"radix-ui": "^1.4.3",
		"react": "^19.2.4",
		"react-markdown": "^9.0.1",
		"tailwind-merge": "^3.5.0"
	},
	"peerDependencies": {
		"next": "16.2.1"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4.2.2",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"jsdom": "^29.1.1",
		"next": "16.2.1",
		"postcss": "^8.5.8",
		"postcss-cli": "^11.0.1",
		"postcss-prefix-selector": "^2.1.1",
		"react-dom": "^19.2.4",
		"tailwindcss": "^4.2.2",
		"types": "workspace:*",
		"typescript": "^5.8.3"
	}
}
